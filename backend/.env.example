# Skopiuj jako .env i uzupelnij. Klucz: python -c "import secrets; print(secrets.token_hex(32))"
ENV=development
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=postgresql+psycopg://caffenacci:caffenacci-dev-password@localhost:5432/caffenacci
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Produkcja: bez localhost, adresy po przecinku
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
PUBLIC_SITE_URL=http://localhost:5174
COMPANY_APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8000
PLAY_STORE_URL=
# Zbudowany klient (npm run build). Użyj slashy także na Windows.
CUSTOMER_DIST_DIR=../caffenacci.customer/dist

# Dev: console. Prod SMTP: Gmail requires an app password.
EMAIL_BACKEND=console
EMAIL_FROM_NAME=Caffenacci
EMAIL_FROM_ADDRESS=noreply@localhost
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Local storage preserves uploads/logos, uploads/gallery and uploads/news.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=uploads/
IMAGE_PROCESSING_CONCURRENCY=2
RUN_SCHEDULER=true
# Dev default true; set false in production when the gateway handles gzip.
ENABLE_APP_GZIP=true
# Shared HTML cache max age; page max-age is 60s and stale-while-revalidate is 600s.
PUBLIC_CACHE_S_MAXAGE=120
PAGE_CACHE_TTL=60
